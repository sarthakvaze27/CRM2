# Copy this file to .env and fill in your own values
WOO_URL=https://your-site.tastewp.com
WOO_KEY=ck_xxxxxxxxxxxxxxxx
WOO_SECRET=cs_xxxxxxxxxxxxxxxx

# Optional: only needed for webhooks (must match the secret you set in WooCommerce)
WOO_WEBHOOK_SECRET=

# Optional: only needed to really send emails (Gmail needs an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Audited Cellar

# Replace with a long random value before sharing this app beyond localhost.
SECRET_KEY=generate-a-random-secret-before-deploying
